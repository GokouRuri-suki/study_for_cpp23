{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-cmake",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "build"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "build-gpp",
      "type": "shell",
      "command": "g++",
      "args": ["-std=c++23", "-g", "${file}", "-o", "out_gpp"],
      "problemMatcher": []
    },
    {
      "label": "build-clang",
      "type": "shell",
      "command": "clang++",
      "args": ["-std=c++23", "-stdlib=libc++", "-g", "${file}", "-o", "out_clang"],
      "problemMatcher": []
    },
    {
      "label": "build-c",
      "type": "shell",
      "command": "gcc",
      "args": ["-std=c17", "-g", "${file}", "-o", "out_c"],
      "problemMatcher": []
    }
  ]
}